# Your Nostr public key (npub..., not hex). Required to show real posts.
NOSTR_NPUB=

# Optional: comma-separated relay list. Defaults to a standard public set.
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band,wss://relay.primal.net

# Optional: only show long-form notes tagged with this hashtag. Defaults to "blog".
# NOSTR_BLOG_TAG=blog
